[Unit]
Description=SettleTrack - Enterprise Settlement & UTR Ledger
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/settletrack
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
