# -------------------------------------------------------------
# SettleTrack - Linux Server IP Hosting Configuration
# -------------------------------------------------------------

# Set this to your Linux Server's IP address and Port
# Example: If your server IP is 192.168.1.150 or 34.120.45.67 on port 3001:
NEXTAUTH_URL="http://YOUR_SERVER_IP:3001"

# Production Secret Key (any random 32+ character string)
NEXTAUTH_SECRET="settletrack-production-secret-key-32chars-min-change-in-prod"

# Server Port (default 3001)
PORT=3001

# Host interface: 0.0.0.0 binds to all network interfaces for direct IP access
HOST="0.0.0.0"

# Optional: PostgreSQL Database URL (Supabase, Neon, AWS RDS, or local Postgres)
# If omitted or un-migrated, SettleTrack automatically uses the robust zero-downtime file ledger!
# DATABASE_URL="postgresql://postgres:password@localhost:5432/settletrack?sslmode=prefer"
