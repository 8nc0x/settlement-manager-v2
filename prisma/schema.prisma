// SettleTrack - Multi-Tier Settlement & UTR Record System
// Prisma Schema for Production PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  subadmin
  merchant
}

enum UserStatus {
  active
  suspended
}

enum SettlementStatus {
  pending
  paid_pending_confirmation
  completed
  disputed
  rejected
}

enum SettlementType {
  merchant_to_subadmin
  subadmin_to_admin
  merchant_to_admin
}

enum PayoutMethod {
  upi
  bank
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String
  name                String
  role                Role        @default(merchant)
  createdBy           String?
  subAdminId          String?
  phone               String?
  businessName        String?
  defaultUpiId        String?
  bankAccountHolder   String?
  bankAccountNumber   String?
  bankIfscCode        String?
  bankName            String?
  status              UserStatus  @default(active)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  requestedSettlements Settlement[] @relation("RequesterSettlements")
  receivedSettlements  Settlement[] @relation("RecipientSettlements")

  @@index([role])
  @@index([subAdminId])
  @@index([createdBy])
}

model Settlement {
  id                   String            @id @default(cuid())
  type                 SettlementType    @default(merchant_to_subadmin)
  
  requesterId          String
  requester            User              @relation("RequesterSettlements", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterName        String
  requesterRole        Role
  requesterBusiness    String?

  recipientId          String
  recipient            User              @relation("RecipientSettlements", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientName        String
  recipientRole        Role

  amount               Decimal           @db.Decimal(14, 2)
  startDate            String            // YYYY-MM-DD
  startTime            String?           // HH:mm
  endDate              String            // YYYY-MM-DD
  endTime              String?           // HH:mm

  payoutMethod         PayoutMethod      @default(upi)
  payoutUpiId          String?
  payoutAccountHolder  String?
  payoutAccountNumber  String?
  payoutIfscCode       String?
  payoutBankName       String?
  merchantNotes        String?

  status               SettlementStatus  @default(pending)

  // Clearing verification details
  clearedAt            DateTime?
  clearedBy            String?
  clearedByName        String?
  clearedByRole        Role?
  utrNumber            String?           // 12-digit UPI/IMPS UTR or Bank Ref
  proofType            String?           // image, file_excel_csv, file_pdf, web_link, voucher
  proofUrl             String?           @db.Text
  proofFileName        String?
  proofFileSize        String?
  proofMimeType        String?
  proofLink            String?
  clearingRemarks      String?

  // Confirmation / dispute details
  confirmedAt          DateTime?
  confirmedBy          String?
  confirmedByName      String?
  confirmationNotes    String?
  isDisputed           Boolean           @default(false)
  disputeReason        String?
  disputedAt           DateTime?

  auditTrail           SettlementAuditLog[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([recipientId])
  @@index([utrNumber])
  @@index([createdAt])
}

model SettlementAuditLog {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  action       String
  actorId      String
  actorName    String
  actorRole    Role
  timestamp    DateTime   @default(now())
  details      String?

  @@index([settlementId])
  @@index([timestamp])
}

model PlatformCollectionAccount {
  id            String       @id @default(cuid())
  type          PayoutMethod @default(upi)
  title         String
  upiId         String?
  accountHolder String
  accountNumber String?
  ifscCode      String?
  bankName      String?
  notes         String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive])
}
